{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/en0ma/order-book/deployments/spec/schema/v1.json",
  "title": "Order Book Deployment Spec",
  "oneOf": [
    { "$ref": "#/$defs/standalone" },
    { "$ref": "#/$defs/portfolio" }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "base": {
      "type": "object",
      "required": ["schemaVersion", "mode", "protocolAdmin", "collateral", "markets"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "enum": ["standalone", "portfolio"] },
        "protocolAdmin": { "$ref": "#/$defs/address" },
        "collateral": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token", "decimals"],
          "properties": {
            "token": { "$ref": "#/$defs/address" },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "marketBase": {
      "type": "object",
      "required": [
        "id",
        "fundingUpdater",
        "oracle",
        "executionBandTicks",
        "initialMarginBps",
        "takerFeeBps",
        "makerRebateBps",
        "collateralUnitsPerLotTick"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fundingUpdater": { "$ref": "#/$defs/address" },
        "oracle": { "$ref": "#/$defs/address" },
        "executionBandTicks": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "initialMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "takerFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "makerRebateBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "collateralUnitsPerLotTick": { "$ref": "#/$defs/uintString" },
        "oracleMaxAgeSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "standaloneMarket": {
      "allOf": [
        { "$ref": "#/$defs/marketBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "fundingUpdater",
            "oracle",
            "executionBandTicks",
            "initialMarginBps",
            "maintenanceMarginBps",
            "takerFeeBps",
            "makerRebateBps",
            "liquidatorRewardBps",
            "collateralUnitsPerLotTick"
          ],
          "properties": {
            "id": {},
            "fundingUpdater": {},
            "oracle": {},
            "executionBandTicks": {},
            "initialMarginBps": {},
            "maintenanceMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "takerFeeBps": {},
            "makerRebateBps": {},
            "liquidatorRewardBps": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "collateralUnitsPerLotTick": {},
            "oracleMaxAgeSeconds": {}
          }
        }
      ]
    },
    "portfolioMarket": {
      "allOf": [
        { "$ref": "#/$defs/marketBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "fundingUpdater",
            "oracle",
            "executionBandTicks",
            "initialMarginBps",
            "takerFeeBps",
            "makerRebateBps",
            "collateralUnitsPerLotTick",
            "riskGroup",
            "portfolioMarginBps",
            "hedgeCreditBps"
          ],
          "properties": {
            "id": {},
            "fundingUpdater": {},
            "oracle": {},
            "executionBandTicks": {},
            "initialMarginBps": {},
            "takerFeeBps": {},
            "makerRebateBps": {},
            "collateralUnitsPerLotTick": {},
            "oracleMaxAgeSeconds": {},
            "riskGroup": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "portfolioMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "hedgeCreditBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        }
      ]
    },
    "standalone": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {},
            "mode": { "const": "standalone" },
            "protocolAdmin": {},
            "collateral": {},
            "markets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/standaloneMarket" }
            }
          }
        }
      ]
    },
    "portfolio": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {},
            "mode": { "const": "portfolio" },
            "protocolAdmin": {},
            "collateral": {},
            "markets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/portfolioMarket" }
            }
          }
        }
      ]
    }
  }
}
