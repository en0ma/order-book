{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/en0ma/order-book/deployments/spec/schema/v1.json",
  "title": "Order Book Deployment Spec",
  "oneOf": [
    { "$ref": "#/$defs/standalone" },
    { "$ref": "#/$defs/portfolio" }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,37}|[1-2][0-9]{38}|3[0-3][0-9]{37}|340[0-1][0-9]{35}|3402[0-7][0-9]{34}|34028[0-1][0-9]{33}|340282[0-2][0-9]{32}|3402823[0-5][0-9]{31}|34028236[0-5][0-9]{30}|340282366[0-8][0-9]{29}|3402823669[0-1][0-9]{28}|340282366920[0-8][0-9]{26}|3402823669209[0-2][0-9]{25}|34028236692093[0-7][0-9]{24}|340282366920938[0-3][0-9]{23}|3402823669209384[0-5][0-9]{22}|34028236692093846[0-2][0-9]{21}|340282366920938463[0-3][0-9]{20}|3402823669209384634[0-5][0-9]{19}|34028236692093846346[0-2][0-9]{18}|340282366920938463463[0-2][0-9]{17}|3402823669209384634633[0-6][0-9]{16}|34028236692093846346337[0-3][0-9]{15}|340282366920938463463374[0-5][0-9]{14}|34028236692093846346337460[0-6][0-9]{12}|340282366920938463463374607[0-3][0-9]{11}|3402823669209384634633746074[0-2][0-9]{10}|340282366920938463463374607430[0-9]{9}|340282366920938463463374607431[0-6][0-9]{8}|3402823669209384634633746074317[0-5][0-9]{7}|34028236692093846346337460743176[0-7][0-9]{6}|340282366920938463463374607431768[0-1][0-9]{5}|34028236692093846346337460743176820[0-9]{4}|340282366920938463463374607431768210[0-9]{3}|340282366920938463463374607431768211[0-3][0-9]{2}|3402823669209384634633746074317682114[0-4][0-9]|34028236692093846346337460743176821145[0-4]|340282366920938463463374607431768211455)$"
    },
    "base": {
      "type": "object",
      "required": ["schemaVersion", "mode", "protocolAdmin", "collateral", "markets"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "enum": ["standalone", "portfolio"] },
        "protocolAdmin": { "$ref": "#/$defs/address" },
        "collateral": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["token", "decimals"],
          "properties": {
            "token": { "$ref": "#/$defs/address" },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "marketBase": {
      "type": "object",
      "required": [
        "id",
        "fundingUpdater",
        "oracle",
        "executionBandTicks",
        "initialMarginBps",
        "takerFeeBps",
        "makerRebateBps",
        "collateralUnitsPerLotTick"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fundingUpdater": { "$ref": "#/$defs/address" },
        "oracle": { "$ref": "#/$defs/address" },
        "executionBandTicks": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "initialMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "takerFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "makerRebateBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "collateralUnitsPerLotTick": { "$ref": "#/$defs/uintString" },
        "oracleMaxAgeSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "standaloneMarket": {
      "allOf": [
        { "$ref": "#/$defs/marketBase" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "id",
            "fundingUpdater",
            "oracle",
            "executionBandTicks",
            "initialMarginBps",
            "maintenanceMarginBps",
            "takerFeeBps",
            "makerRebateBps",
            "liquidatorRewardBps",
            "collateralUnitsPerLotTick"
          ],
          "properties": {
            "id": {},
            "fundingUpdater": {},
            "oracle": {},
            "executionBandTicks": {},
            "initialMarginBps": {},
            "maintenanceMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "takerFeeBps": {},
            "makerRebateBps": {},
            "liquidatorRewardBps": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "collateralUnitsPerLotTick": {},
            "oracleMaxAgeSeconds": {}
          }
        }
      ]
    },
    "portfolioMarket": {
      "allOf": [
        { "$ref": "#/$defs/marketBase" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "id",
            "fundingUpdater",
            "oracle",
            "executionBandTicks",
            "initialMarginBps",
            "takerFeeBps",
            "makerRebateBps",
            "collateralUnitsPerLotTick",
            "riskGroup",
            "portfolioMarginBps",
            "hedgeCreditBps"
          ],
          "properties": {
            "id": {},
            "fundingUpdater": {},
            "oracle": {},
            "executionBandTicks": {},
            "initialMarginBps": {},
            "takerFeeBps": {},
            "makerRebateBps": {},
            "collateralUnitsPerLotTick": {},
            "oracleMaxAgeSeconds": {},
            "riskGroup": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "portfolioMarginBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "hedgeCreditBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        }
      ]
    },
    "standalone": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "schemaVersion": {},
            "mode": { "const": "standalone" },
            "protocolAdmin": {},
            "collateral": {},
            "markets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/standaloneMarket" }
            }
          }
        }
      ]
    },
    "portfolio": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "schemaVersion": {},
            "mode": { "const": "portfolio" },
            "protocolAdmin": {},
            "collateral": {},
            "markets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/portfolioMarket" }
            }
          }
        }
      ]
    }
  }
}
