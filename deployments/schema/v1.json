{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/en0ma/order-book/deployments/schema/v1.json",
  "title": "Order Book Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chainId", "deploymentBlock", "packageVersion", "collateral", "markets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "deploymentBlock": { "type": "integer", "minimum": 0 },
    "packageVersion": { "type": "string", "minLength": 1 },
    "collateral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "decimals"],
      "properties": {
        "token": { "$ref": "#/$defs/address" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinator", "policy", "vault"],
      "properties": {
        "coordinator": { "$ref": "#/$defs/address" },
        "policy": { "$ref": "#/$defs/address" },
        "vault": { "$ref": "#/$defs/address" }
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/market" }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "core", "advanced", "oracle", "scales", "parameters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "core": { "$ref": "#/$defs/address" },
        "advanced": { "$ref": "#/$defs/address" },
        "marketMaker": { "$ref": "#/$defs/address" },
        "liquidation": { "$ref": "#/$defs/address" },
        "portfolioLiquidation": { "$ref": "#/$defs/address" },
        "integrationLens": { "$ref": "#/$defs/address" },
        "oracle": { "$ref": "#/$defs/address" },
        "portfolioMarketIndex": { "type": "integer", "minimum": 0, "maximum": 255 },
        "scales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collateralUnitsPerLotTick"],
          "properties": {
            "collateralUnitsPerLotTick": { "$ref": "#/$defs/uintString" }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executionBandTicks", "initialMarginBps", "takerFeeBps", "makerRebateBps"],
          "properties": {
            "executionBandTicks": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "initialMarginBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "maintenanceMarginBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "takerFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "makerRebateBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "oracleMaxAgeSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
