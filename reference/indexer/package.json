{
  "name": "@en0ma/order-book-reference-indexer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./abi": {
      "types": "./src/abi.ts",
      "import": "./dist/abi.js",
      "default": "./dist/abi.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
