<mxfile host="app.diagrams.net"><diagram name="Perpetual market listing lifecycle"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Market design — Collateral, oracle, lot scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="110" as="geometry"/></mxCell><mxCell id="n1" value="Risk sign-off — Margin, funding, liquidation liquidity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="320" height="110" as="geometry"/></mxCell><mxCell id="n2" value="Deploy — Standalone modules + role handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="320" height="110" as="geometry"/></mxCell><mxCell id="n3" value="Verify — Manifest + exact runtime code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="320" height="110" as="geometry"/></mxCell><mxCell id="n4" value="Bootstrap — Makers, indexer, keepers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="320" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Operate — Monitor, reconcile, recover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#4D829E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="320" height="110" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="n0" target="n1" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="n1" target="n2" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" par